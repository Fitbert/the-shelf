# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Discogs — https://www.discogs.com/settings/developers, "create an application"
# gives you these two values. Server-side only. Never expose them to the client.
DISCOGS_CONSUMER_KEY=your-discogs-consumer-key
DISCOGS_CONSUMER_SECRET=your-discogs-consumer-secret
DISCOGS_USER_AGENT=TheShelf/1.0 +https://example.com
