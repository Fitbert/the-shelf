# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Discogs — https://www.discogs.com/settings/developers (register an app, use its token)
# Server-side only. Never expose this to the client.
DISCOGS_TOKEN=your-discogs-personal-access-token
DISCOGS_USER_AGENT=TheShelf/1.0 +https://example.com
